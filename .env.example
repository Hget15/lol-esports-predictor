# Copy this file to `.env` and fill in real values. `.env` is gitignored and never committed.

# Riot Games API key (https://developer.riotgames.com/).
# Development-tier keys expire every 24h; regenerate from the developer portal.
# Not currently used by any script — reserved for planned solo-queue data enrichment.
RIOT_API_KEY=RGAPI-your-development-key-here
